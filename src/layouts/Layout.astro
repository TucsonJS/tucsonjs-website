---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'TucsonJS — Tucson JavaScript Meetup',
  description = 'A welcoming monthly meetup for web developers in Tucson, AZ. Come learn, share, and build community.',
} = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const ogImage = new URL(`${base}/og-image.png`, Astro.site);
const faviconHref = `${base}/favicon.png`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href={faviconHref} />
    <meta name="generator" content={Astro.generator} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&display=swap"
      rel="stylesheet"
    />

    <title>{title}</title>

    <script is:inline>
      // Runs before paint to avoid a light/dark flash on load.
      (function () {
        try {
          const stored = localStorage.getItem('tucsonjs-theme');
          if (stored === 'light' || stored === 'dark') {
            document.documentElement.setAttribute('data-theme', stored);
          }
        } catch (e) {
          // localStorage unavailable — fall back to prefers-color-scheme.
        }
      })();
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
