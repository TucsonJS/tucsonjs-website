---
import { events } from '../data/site';
---

{
  events.length > 0 && (
    <section id="next-event" class="content-section">
      <div class="container">
        <p class="eyebrow centered">
          {events.length > 1 ? 'Upcoming Events' : 'Next Event'}
        </p>
        <div class="event-list">
          {events.map((event) => (
            <div class="card event-card">
              <h2 class="section-heading">{event.title}</h2>
              <div class="details">
                <div class="detail">
                  <svg
                    width="20"
                    height="20"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <rect x="3" y="4" width="18" height="18" rx="2" />
                    <path d="M16 2v4M8 2v4M3 10h18" />
                  </svg>
                  <span>
                    {event.date && event.time
                      ? `${event.date} · ${event.time}`
                      : 'Date & time announced closer to the event'}
                  </span>
                </div>
                <div class="detail">
                  <svg
                    width="20"
                    height="20"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z" />
                    <circle cx="12" cy="10" r="3" />
                  </svg>
                  <span>{event.location}</span>
                </div>
              </div>
              <a
                class="button button-primary"
                href={event.lumaUrl}
                target="_blank"
                rel="noopener noreferrer"
                data-plausible-event-name="Luma Click"
              >
                RSVP on Luma
              </a>
            </div>
          ))}
        </div>
      </div>
    </section>
  )
}

<style>
  .centered {
    display: block;
    text-align: center;
  }

  .event-list {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    max-width: 640px;
    margin-inline: auto;
  }

  .details {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    margin-block: 1.5rem 2rem;
  }

  .detail {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 1rem;
    color: var(--color-text-muted);
  }

  .detail svg {
    color: var(--color-accent-pink);
    flex-shrink: 0;
  }
</style>
