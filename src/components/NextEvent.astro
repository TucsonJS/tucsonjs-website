---
import { events } from '../data/site';

const todayIsoDate = new Date().toISOString().slice(0, 10);
const upcomingEvents = events.filter(
  (event) => !event.isoDate || event.isoDate >= todayIsoDate
);
---

{
  upcomingEvents.length > 0 && (
    <section id="next-event" class="content-section">
      <div class="container">
        <p class="eyebrow centered">
          {upcomingEvents.length > 1 ? 'Upcoming Events' : 'Next Event'}
        </p>
        <div class="event-list">
          {upcomingEvents.map((event) => (
            <div class="card event-card">
              <h2 class="section-heading">{event.title}</h2>
              <div class="details">
                <div class="detail">
                  <i class="fa-duotone fa-calendar-clock" />
                  <span>
                    {event.date && event.time
                      ? `${event.date} · ${event.time}`
                      : 'Date & time announced closer to the event'}
                  </span>
                </div>
                <div class="detail">
                  <i class="fa-duotone fa-map-location-dot" />
                  <span>{event.location}</span>
                </div>
              </div>
              {event.lumaUrl && (
                <a
                  class="button button-primary"
                  href={event.lumaUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  data-plausible-event-name="Luma Click"
                >
                  RSVP on Luma
                </a>
              )}
            </div>
          ))}
        </div>
      </div>
    </section>
  )
}

<style>
  .centered {
    display: block;
    text-align: center;
  }

  .event-list {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    max-width: 640px;
    margin-inline: auto;
  }

  .details {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    margin-block: 1.5rem 2rem;
  }

  .detail {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 1rem;
    color: var(--color-text-muted);
  }

  .detail i {
    font-size: 1.25rem;
    flex-shrink: 0;
    --fa-secondary-opacity: 1;
  }

  .fa-calendar-clock {
    --fa-primary-color: var(--color-accent-pink);
    --fa-secondary-color: var(--color-accent-teal);
  }

  .fa-map-location-dot {
    --fa-primary-color: var(--color-accent-teal);
    --fa-secondary-color: var(--color-accent-pink);
  }
</style>
