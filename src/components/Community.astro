---
import { links } from '../data/site';

const items = [
  { name: 'Luma', description: 'RSVP to every event', href: links.luma },
  { name: 'Discord', description: 'Chat between meetups', href: links.discord },
  {
    name: 'GitHub',
    description: "See what we're building",
    href: links.github,
  },
];
---

<section id="community" class="content-section">
  <div class="container">
    <div class="heading">
      <p class="eyebrow">Community</p>
      <h2 class="section-heading">Find us between meetups</h2>
    </div>
    <div class="grid">
      {
        items.map((item) => (
          <a
            class="card link-card"
            href={item.href}
            target="_blank"
            rel="noopener noreferrer"
            data-plausible-event-name={`${item.name} Click`}
          >
            <div class="name">{item.name}</div>
            <div class="description">{item.description}</div>
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  .heading {
    text-align: center;
    margin-bottom: 2.5rem;
  }

  .grid {
    display: grid;
    gap: 1.5rem;
    grid-template-columns: 1fr;
    max-width: 900px;
    margin-inline: auto;
  }

  .link-card {
    text-align: center;
    color: var(--color-text);
  }

  .name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.1rem;
    margin-bottom: 0.4rem;
  }

  .description {
    font-size: 0.9rem;
    color: var(--color-text-muted);
  }

  @media (min-width: 720px) {
    .grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
