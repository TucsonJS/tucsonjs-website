---
import { links, codeOfConductSummary } from '../data/site';
---

<section id="conduct" class="content-section">
  <div class="container conduct">
    <p class="eyebrow">Code of Conduct</p>
    <h2 class="section-heading">Everyone is welcome here</h2>
    <p class="lede">{codeOfConductSummary}</p>
    <a
      class="link"
      href={links.codeOfConduct}
      target="_blank"
      rel="noopener noreferrer"
      data-plausible-event-name="Code of Conduct Click"
    >
      Read the full Code of Conduct →
    </a>
  </div>
</section>

<style>
  .conduct {
    max-width: 720px;
    text-align: center;
  }

  .lede {
    font-size: 1.05rem;
    line-height: 1.7;
  }

  .link {
    font-weight: 600;
    color: var(--color-accent-pink);
  }
</style>
